# ====================================================================
# KOFFI POS & LOYALTY VPS BACKEND ENVIRONMENT VARIABLES
# ====================================================================

PORT=3000
NODE_ENV=production

# Supabase Credentials (Dapatkan dari Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase JWT Secret (Dapatkan dari Settings -> API -> JWT Settings -> JWT Secret)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Staff POS JWT Secret (Strictly separated from Customer JWT Secret)
STAFF_JWT_SECRET=your_staff_jwt_secret_here

# Allowed Origins for CORS (Masukkan domain Vercel anda di sini, cth: https://koffi-pos.vercel.app)
ALLOWED_ORIGINS=http://localhost:3000,https://your-pos-domain.vercel.app,https://your-loyalty-domain.vercel.app

# Redis Cache (Pilihan / Opsional untuk OTP & Rate Limiting)
REDIS_URL=redis://localhost:6379

# WhatsApp Gateway API (Fonnte / WABA / Custom Gateway)
WA_API_URL=https://api.fonnte.com/send
WA_API_TOKEN=your_whatsapp_gateway_token_here
WA_WEBHOOK_SECRET=koffi_pos_secret_key

# Telegram Bot (Untuk Pengesahan Pengurus & Notifikasi)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_manager_chat_id_here
